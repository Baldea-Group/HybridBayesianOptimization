# Matplotlib style for 16:9 presentation slides (e.g. PowerPoint)
# Larger text, thicker lines, high contrast

# ---- Figure ----
figure.figsize:     13.33, 7.5
figure.dpi:         150
figure.facecolor:   white
figure.edgecolor:   white
savefig.dpi:        300
savefig.bbox:       tight
savefig.pad_inches: 0.15

# ---- Font ----
font.family:        sans-serif
font.sans-serif:    Arial, Helvetica, DejaVu Sans
font.size:          18

# ---- Axes ----
axes.titlesize:     22
axes.titleweight:   bold
axes.titlepad:      12
axes.labelsize:     20
axes.labelpad:      8
axes.linewidth:     1.5
axes.grid:          True
axes.grid.which:    major
axes.spines.top:    False
axes.spines.right:  False
axes.prop_cycle:    cycler('color', ['0C5DA5', 'FF2C00', '00B945', 'FF9500', '845B97', '474747', 'C20078', '9e9e9e'])

# ---- Grid ----
grid.color:         e0e0e0
grid.linewidth:     0.8
grid.alpha:         0.7

# ---- Ticks ----
xtick.labelsize:    16
ytick.labelsize:    16
xtick.major.size:   6
ytick.major.size:   6
xtick.major.width:  1.3
ytick.major.width:  1.3
xtick.minor.size:   3
ytick.minor.size:   3
xtick.direction:    out
ytick.direction:    out

# ---- Lines ----
lines.linewidth:    2.5
lines.markersize:   8

# ---- Legend ----
legend.fontsize:    16
legend.frameon:     True
legend.framealpha:  0.9
legend.edgecolor:   cccccc
legend.fancybox:    True
legend.handlelength: 1.5

# ---- Patches (for bar charts, etc.) ----
patch.linewidth:    1.0
